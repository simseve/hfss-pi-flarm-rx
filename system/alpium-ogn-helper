# First boot, field Wi-Fi, 4G
# ---------------------------------------------------------------------------

AGENT_HOME = "/home/hfss"
FIELD_WIFI_ID = "alpium-field"
FIELD_WIFI_PRIORITY = -100
GSM_ID = "alpium-4g"


def join_tailnet():
    d = read_json()
    authkey, hostname, tag, key = d.get("authkey"), d.get("hostname"), d.get("tag"), d.get("ssh_public_key")
    if not isinstance(authkey, str) or not re.fullmatch(r"tskey-auth-[A-Za-z0-9-]{10,200}", authkey):
        fail("Bad Tailscale key")
    if not isinstance(hostname, str) or not re.fullmatch(r"ogn-[0-9a-f]{8}", hostname):
        fail("Bad hostname")
    if tag != "tag:ogn":
        fail("Bad tag")
    m = re.fullmatch(r"(ssh-ed25519 [A-Za-z0-9+/=]{40,100}) alpium-ogn", str(key or "").strip())
    if not m:
        fail("Bad SSH key")
    # Alpium's key, usable from the tailnet only and for a shell only.
    ssh_dir = os.path.join(AGENT_HOME, ".ssh")
    auth = os.path.join(ssh_dir, "authorized_keys")
    os.makedirs(ssh_dir, mode=0o700, exist_ok=True)
    lines = []
    if os.path.exists(auth):
        with open(auth) as f:
            lines = [l for l in f.read().splitlines() if not l.rstrip().endswith(" alpium-ogn")]
    lines.append('from="100.64.0.0/10",no-agent-forwarding,no-port-forwarding,no-X11-forwarding ' + m.group(1) + " alpium-ogn")
    with open(auth + ".new", "w") as f:
        f.write("\n".join(lines) + "\n")
    os.chmod(auth + ".new", 0o600)
    shutil.chown(auth + ".new", "hfss", "hfss")
    shutil.chown(ssh_dir, "hfss", "hfss")
    os.replace(auth + ".new", auth)
    run("tailscale", "logout")
    r = subprocess.run(["tailscale", "up", "--reset", f"--auth-key={authkey}", f"--hostname={hostname}",
                        f"--advertise-tags={tag}", "--ssh=false", "--accept-dns=false", "--accept-routes=false"],
                       capture_output=True, text=True, timeout=120)
    if r.returncode != 0:
        fail("tailscale up failed: " + (r.stderr or r.stdout).strip()[:200])
    ok(f"On the tailnet as {hostname}")


HOSTNAME_RE = r"ogn-[0-9a-f]{8}"
HOSTS_FILE = "/etc/hosts"
# cloud-init's update_hostname runs at every boot and would put back the name
# Imager wrote in user-data; this keeps the one set here.
CLOUD_HOSTNAME_CFG = "/etc/cloud/cloud.cfg.d/99-alpium-hostname.cfg"


def set_hostname(name):
    """Name the Pi like its station (ogn-<serial>), once it is enrolled.

    Every card of a batch is written with the same Imager settings, so the
    name Imager gave is not the station's; the agent calls this with the name
    Alpium uses on the tailnet. Idempotent.
    """
    if not isinstance(name, str) or not re.fullmatch(HOSTNAME_RE, name):
        fail("Bad hostname")
    current = run("hostname").stdout.strip()
    if os.path.isdir(os.path.dirname(CLOUD_HOSTNAME_CFG)):
        with open(CLOUD_HOSTNAME_CFG, "w") as f:
            f.write("# Written by alpium-ogn-helper: the station names itself.\npreserve_hostname: true\n")
    if current != name:
        # systemd-hostnamed writes /etc/hostname; it is outside this sandbox.
        if run("hostnamectl", "set-hostname", name).returncode != 0:
            fail("Could not set the hostname")
    # 127.0.1.1 names the Pi itself; without it sudo stalls resolving the name.
    # Rewritten in place: /etc/hosts is a single writable file in the sandbox.
    with open(HOSTS_FILE, "r+") as f:
        lines = f.read().splitlines()
        kept = [l for l in lines if not re.match(r"\s*127\.0\.1\.1\s", l)]
        kept.append(f"127.0.1.1\t{name}")
        if kept != lines:
            f.seek(0)
            f.write("\n".join(kept) + "\n")
            f.truncate()
    ok(f"Hostname {name}" + ("" if current == name else f" (was {current})"), changed=current != name)


def delete_connection_files(conn_id):
    """Remove every NetworkManager connection with this id (keyfiles we wrote)."""
    for c in run("nmcli", "-t", "-f", "NAME", "connection", "show").stdout.splitlines():
        if c.replace("\\:", ":") == conn_id:
            run("nmcli", "connection", "delete", "id", conn_id)


def wifi_field():
    require_nm()
    d = read_json()
    delete_connection_files(FIELD_WIFI_ID)
    if d.get("remove"):
        run("nmcli", "connection", "reload")
        ok("Field Wi-Fi removed")
    ssid, psk = d.get("ssid"), d.get("psk")
    if not valid_ssid(ssid):
        fail("Invalid SSID")
    if not valid_psk(psk):
        fail("Password must be 8-63 printable characters (no backslash) or 64 hex digits")
    conn_uuid = str(uuid.uuid4())
    path = os.path.join(NM_DIR, f"{FIELD_WIFI_ID}.nmconnection")
    body = (
        "[connection]\n"
        f"id={FIELD_WIFI_ID}\nuuid={conn_uuid}\ntype=wifi\ninterface-name=wlan0\n"
        f"autoconnect-priority={FIELD_WIFI_PRIORITY}\n\n"
        "[wifi]\nmode=infrastructure\n"
        f"ssid={ssid}\n\n"
        "[wifi-security]\nkey-mgmt=wpa-psk\n"
        f"psk={psk}\n\n"
        "[ipv4]\nmethod=auto\n\n[ipv6]\nmethod=auto\n"
    )
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(body)
    if run("nmcli", "connection", "reload").returncode != 0:
        fail("NetworkManager refused the field Wi-Fi")
    ok(f"Field Wi-Fi {ssid} installed (used only when no other network is reachable)")


def printable(value, limit=64):
    return value is None or (isinstance(value, str) and len(value) <= limit
                             and re.fullmatch(r"[\x21-\x7e]*", value) is not None and "\\" not in value)


def gsm_set():
    require_nm()
    d = read_json()
    write_gsm(d.get("apn"), d.get("username"), d.get("password"), d.get("pin"))
    ok(f"4G connection set (APN {d.get('apn')})")


def write_gsm(apn, user, password, pin):
    """Validate and write the alpium-4g NetworkManager keyfile, bring it up."""
    if not isinstance(apn, str) or not re.fullmatch(r"[A-Za-z0-9._-]{1,64}", apn):
        fail("Invalid APN")
    if not printable(user) or not printable(password):
        fail("Username and password: printable characters, no spaces or backslash")
    if pin is not None and not re.fullmatch(r"[0-9]{4,8}", str(pin)):
        fail("PIN must be 4-8 digits")
    delete_connection_files(GSM_ID)
    gsm = f"apn={apn}\n"
    if user:
        gsm += f"username={user}\n"
    if password:
        gsm += f"password={password}\n"
    if pin:
        gsm += f"pin={pin}\n"
    body = (
        "[connection]\n"
        f"id={GSM_ID}\nuuid={uuid.uuid4()}\ntype=gsm\nautoconnect=true\n\n"
        f"[gsm]\n{gsm}\n"
        "[ipv4]\nmethod=auto\n\n[ipv6]\nmethod=auto\n"
    )
    path = os.path.join(NM_DIR, f"{GSM_ID}.nmconnection")
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(body)
    if run("nmcli", "connection", "reload").returncode != 0:
        fail("NetworkManager refused the 4G connection")
    run("nmcli", "connection", "up", "id", GSM_ID)


PROVIDERS_XML = "/usr/share/mobile-broadband-provider-info/serviceproviders.xml"


def first_modem():
    """ModemManager's first modem as a dict, or None."""
    if not shutil.which("mmcli"):
        return None
    try:
        paths = json.loads(run("mmcli", "-L", "-J").stdout or "{}").get("modem-list") or []
        if not paths:
            return None
        return json.loads(run("mmcli", "-m", paths[0].rsplit("/", 1)[-1], "-J").stdout or "{}").get("modem") or None
    except ValueError:
        return None


def sim_operator_code(modem):
    """MCC+MNC of the SIM (not of the network: roaming must not pick the
    visited network's APN), or None when the SIM cannot be read (PIN)."""
    sim = (modem.get("generic") or {}).get("sim")
    if not sim or sim == "--":
        return None
    try:
        props = json.loads(run("mmcli", "-i", sim.rsplit("/", 1)[-1], "-J").stdout or "{}") \
            .get("sim", {}).get("properties", {})
    except ValueError:
        return None
    code = str(props.get("operator-code") or "")
    if not code and props.get("imsi"):
        code = str(props["imsi"])[:6]
    return code if re.fullmatch(r"[0-9]{5,6}", code) else None


def lookup_apn(operator_code, xml_path=PROVIDERS_XML):
    """(apn, username, password) for this MCC+MNC from the operator database.

    The first APN marked for internet use, else the first APN. MNCs are
    compared as numbers ("01" == "1"); a 6-digit code is tried as 3+3 before
    3+2.
    """
    import xml.etree.ElementTree as ET
    try:
        root = ET.parse(xml_path).getroot()
    except (OSError, ET.ParseError):
        return None
    mcc = operator_code[:3]
    mncs = [operator_code[3:]] if len(operator_code) == 5 else [operator_code[3:], operator_code[3:5]]
    for mnc in mncs:
        for provider in root.iter("provider"):
            ids = provider.findall("./gsm/network-id")
            if not any(i.get("mcc") == mcc and int(i.get("mnc", "-1")) == int(mnc) for i in ids):
                continue
            apns = provider.findall("./gsm/apn")
            internet = [a for a in apns if any(u.get("type") == "internet" for u in a.findall("usage"))]
            for a in internet + apns:
                value = a.get("value")
                if value and re.fullmatch(r"[A-Za-z0-9._-]{1,64}", value):
                    return value, (a.findtext("username") or None), (a.findtext("password") or None)
    return None


def gsm_auto():
    """Set up a new modem by itself, so a station on 4G alone gets online."""
    require_nm()
    names = [c.replace("\\:", ":") for c in run("nmcli", "-t", "-f", "NAME", "connection", "show").stdout.splitlines()]
    if GSM_ID in names:
        ok("4G already configured", configured=True)
    modem = first_modem()
    if not modem:
        ok("no modem", configured=False)
    state = (modem.get("generic") or {}).get("state")
    if state == "locked":
        ok("SIM locked: set its PIN in Alpium (Manage, Network, 4G)", configured=False)
    code = sim_operator_code(modem)
    if not code:
        ok("SIM operator unknown yet", configured=False)
    found = lookup_apn(code)
    if not found:
        ok(f"no APN known for operator {code}: set it in Alpium", configured=False)
    apn, user, password = found
    if not printable(user) or not printable(password):
        user, password = None, None
    write_gsm(apn, user, password, None)
    ok(f"4G set up for operator {code} (APN {apn})", configured=True, apn=apn)


def gsm_status():
    if not shutil.which("mmcli"):
        ok("no ModemManager", modem=None)
    try:
        listing = json.loads(run("mmcli", "-L", "-J").stdout or "{}")
    except ValueError:
        ok("no modem", modem=None)
    paths = listing.get("modem-list") or []
    if not paths:
        ok("no modem", modem=None)
    try:
        m = json.loads(run("mmcli", "-m", paths[0].rsplit("/", 1)[-1], "-J").stdout or "{}").get("modem", {})
    except ValueError:
        ok("modem unreadable", modem=None)
    generic, gpp = m.get("generic", {}), m.get("3gpp", {})
    ok("ok", modem={
        "model": " ".join(x for x in (generic.get("manufacturer"), generic.get("model")) if x)[:80],
        "state": generic.get("state"),
        "failed_reason": generic.get("state-failed-reason"),
        "signal_percent": (generic.get("signal-quality") or {}).get("value"),
        "access": ",".join(generic.get("access-technologies") or []),
        "operator": gpp.get("operator-name"),
        "registration": gpp.get("registration-state"),
        "sim": generic.get("sim"),
    })


def main(argv):
    if not argv:
        fail("No command")
    cmd, args = argv[0], argv[1:]

    if cmd == "restart-ogn" and not args:
        r = run("systemctl", "restart", OGN_SERVICE)
        if r.returncode != 0:
            fail("Could not restart the OGN service")
        ok("OGN receiver restarted")

    if cmd == "link" and len(args) == 2 and args[0] in IFACES and args[1] in ("up", "down"):
        iface, state = args
        if state == "down":
            routes = run("ip", "-o", "route", "show", "default").stdout.split("\n")
            devs = {m.group(1) for line in routes if (m := re.search(r"\bdev (\S+)", line))}
            if devs == {iface}:
                fail(f"{iface} carries the only default route; taking it down would cut the station off")
        if run("ip", "link", "set", iface, state).returncode != 0:
            fail(f"Could not set {iface} {state}")
        ok(f"{iface} {state}")

    if cmd == "wifi-list" and not args:
        require_nm()
        ok("ok", networks=wifi_connections())

    if cmd == "wifi-add" and not args:
        require_nm()
        d = read_json()
        ssid, psk = d.get("ssid"), d.get("psk")
        try:
            priority = int(d.get("priority", 1))
        except (TypeError, ValueError):
            fail("Priority must be a number")
        if not valid_ssid(ssid):
            fail("Invalid SSID")
        if not valid_psk(psk):
            fail("Password must be 8-63 printable characters (no backslash) or 64 hex digits")
        if not -999 <= priority <= 999:
            fail("Priority out of range")
        if any(c["name"] == ssid for c in wifi_connections()):
            fail(f"A network named {ssid} already exists")
        write_keyfile(ssid, psk, priority)
        ok(f"Network {ssid} added")

    if cmd == "wifi-set-psk" and not args:
        require_nm()
        d = read_json()
        name, psk = d.get("name"), d.get("psk")
        if not valid_psk(psk):
            fail("Password must be 8-63 printable characters (no backslash) or 64 hex digits")
        match = next((c for c in wifi_connections() if c["name"] == name), None)
        if not match:
            fail("Network not found")
        ssid = run("nmcli", "-g", "802-11-wireless.ssid", "connection", "show", "id", name).stdout.strip()
        if not valid_ssid(ssid):
            fail("This network's SSID cannot be rewritten here")
        if run("nmcli", "connection", "delete", "id", name).returncode != 0:
            fail("Could not update the network")
        write_keyfile(ssid, psk, int(match["priority"] or 0))
        ok("Password updated")

    if cmd == "wifi-delete" and len(args) == 1:
        require_nm()
        if not any(c["name"] == args[0] for c in wifi_connections()):
            fail("Network not found")
        if run("nmcli", "connection", "delete", "id", args[0]).returncode != 0:
            fail("Could not delete the network")
        ok("Network deleted")

    if cmd == "set-hostname" and len(args) == 1:
        set_hostname(args[0])

    if cmd == "join" and not args:
        join_tailnet()

    if cmd == "wifi-field" and not args:
        wifi_field()

    if cmd == "gsm-set" and not args:
        gsm_set()

    if cmd == "gsm-status" and not args:
        gsm_status()

    if cmd == "gsm-auto" and not args:
        gsm_auto()

    if cmd == "update" and not args:
        start_update()

    if cmd == "apply-update" and not args:
        apply_update()

    fail("Unknown command")


if __name__ == "__main__":
    if os.geteuid() != 0:
        fail("Must run as root (through sudo)")
    main(sys.argv[1:])
