#!/usr/bin/python3 -I
"""The Pi's green light tells the person on site whether the station works.

Nobody from Alpium is there when a station is plugged in, and the person who
does it is usually not technical, so the station says it with its own light:

    steady on      online and receiving: done
    slow blink     connecting (no internet yet, or not approved yet)
    fast blink     online, but the receiver hears nothing: check that the
                   antenna stick is plugged in

The agent (unprivileged) writes its state, one word, to /run/alpium-ogn/led
every 15 s; this service (root, since the LED lives in /sys) shows it. A state
file older than STALE_S means the agent is not running: shown as connecting.
On exit the LED gets back the trigger it had (SD card activity).
"""
import os
import signal
import sys
import time

STATE_FILE = "/run/alpium-ogn/led"
LEDS = ("/sys/class/leds/ACT", "/sys/class/leds/led0")
STALE_S = 120
POLL_S = 2
BLINK = {"connecting": (1000, 1000), "fault": (150, 150)}


def led_dir():
    return next((d for d in LEDS if os.path.isdir(d)), None)


def write(path, value):
    with open(path, "w") as f:
        f.write(str(value))


def current_trigger(led):
    try:
        with open(os.path.join(led, "trigger")) as f:
            for word in f.read().split():
                if word.startswith("["):
                    return word.strip("[]")
    except OSError:
        pass
    return "mmc0"


def read_state(now=None):
    now = time.time() if now is None else now
    try:
        if now - os.stat(STATE_FILE).st_mtime > STALE_S:
            return "connecting"
        with open(STATE_FILE) as f:
            state = f.read().strip()
    except OSError:
        return "connecting"
    return state if state in ("ok", "connecting", "fault") else "connecting"


def show(led, state):
    if state == "ok":
        write(os.path.join(led, "trigger"), "none")
        try:
            with open(os.path.join(led, "max_brightness")) as f:
                top = f.read().strip() or "1"
        except OSError:
            top = "1"
        write(os.path.join(led, "brightness"), top)
    else:
        on, off = BLINK[state]
        write(os.path.join(led, "trigger"), "timer")
        write(os.path.join(led, "delay_on"), on)
        write(os.path.join(led, "delay_off"), off)


def main():
    led = led_dir()
    if not led:
        print("No green LED on this board; nothing to show", flush=True)
        while True:
            time.sleep(3600)
    original = current_trigger(led)

    def restore(*_):
        try:
            write(os.path.join(led, "trigger"), original)
        except OSError:
            pass
        sys.exit(0)

    signal.signal(signal.SIGTERM, restore)
    signal.signal(signal.SIGINT, restore)
    shown = None
    while True:
        state = read_state()
        if state != shown:
            try:
                show(led, state)
                shown = state
                print(f"LED: {state}", flush=True)
            except OSError as e:
                print(f"LED write failed: {e}", flush=True)
        time.sleep(POLL_S)


if __name__ == "__main__":
    main()
