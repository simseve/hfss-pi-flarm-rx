# The Alpium station agent: the signed control API on :8082 (no web pages;
# reached only over the tailnet, see firewall.nft) and the heartbeat to Alpium. Runs as hfss; the
# few root actions go through /usr/local/sbin/alpium-ogn-helper via sudo.
# Restarted forever, so a crash or a power cut never leaves a station silent
# until somebody re-runs the installer.
[Unit]
Description=Alpium OGN station agent
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
User=hfss
Group=hfss
WorkingDirectory=/home/hfss/hfss-pi-flarm-rx
EnvironmentFile=-/etc/default/alpium-ogn-station
ExecStart=/usr/bin/python3 -I -u /home/hfss/hfss-pi-flarm-rx/ogn-station-agent.py
Restart=always
RestartSec=10
# sudo for the helper needs privilege changes, so NoNewPrivileges stays off;
# everything else is closed.
PrivateTmp=yes
ProtectSystem=full
# ProtectSystem makes /etc read-only for the agent AND for the root helper it
# runs through sudo (same mount namespace). The helper writes NetworkManager
# keyfiles (Wi-Fi, field Wi-Fi, 4G): that one directory, nothing else.
ReadWritePaths=/etc/NetworkManager/system-connections
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=no
LockPersonality=yes

[Install]
WantedBy=multi-user.target
