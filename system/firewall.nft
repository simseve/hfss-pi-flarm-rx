#!/usr/sbin/nft -f
# Inbound firewall of an Alpium OGN station (docs: PRODUCTION-DEPLOYMENT.md).
#
# The station sits on networks we do not control (a club house, a hut, a
# farmer's router). It serves no web pages. From the tailnet only two ports
# are open: the signed control API (8082, Alpium's server is its only client)
# and SSH. The OGN status pages (8080/8081) and procServ (50000/50001) are
# local only; the agent relays the status pages to Alpium.
# On the local network only SSH is open (key-only, see sshd drop-in), for an
# on-site rescue when Tailscale itself is down; install.sh --no-lan-ssh
# closes it too.
#
# Outbound is untouched: the station must reach glidernet, Alpium, Tailscale.

table inet alpium_ogn
delete table inet alpium_ogn

table inet alpium_ogn {
  chain input {
    type filter hook input priority filter; policy drop;

    iif lo accept
    ct state established,related accept
    ct state invalid drop

    # Neighbour discovery, ping, path MTU.
    meta l4proto { icmp, ipv6-icmp } accept

    # DHCP replies when not tracked as established.
    udp sport 67 udp dport 68 accept
    udp sport 547 udp dport 546 accept

    # From the tailnet: SSH and the control API only. Tailscale ACLs decide
    # who may connect; the API also requires Alpium's signature.
    iifname "tailscale0" tcp dport { 22, 8082 } accept

    # Tailscale direct connections.
    udp dport 41641 accept

    # On-site SSH rescue (removed by install.sh --no-lan-ssh).
    tcp dport 22 accept comment "lan-ssh"
  }
}
